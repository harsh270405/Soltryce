[TEMPLATE]
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Use localhost for runserver/celery commands started on your computer.
# Docker Compose overrides this to its internal `db` hostname automatically.
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/soltryce_ai
RUNNING_IN_DOCKER=false
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# --- RAG Configuration ---
# Retrieval floor for all-MiniLM-L6-v2 cosine scores (not a percentage).
RAG_MIN_SCORE=0.15
# Maximum chunks returned per query (before reranking).
RAG_MAX_CHUNKS=8
# Reciprocal Rank Fusion weights for hybrid search.
RAG_DENSE_WEIGHT=0.7
RAG_SPARSE_WEIGHT=0.3
# Chunks to keep after cross-encoder reranking.
RAG_RERANK_TOP_K=5
# Chunking parameters for ingestion.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200

# --- Embedding & Reranker ---
# Dense embedding model name (HuggingFace Hub).
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# Cross-encoder reranker model.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Query Processing ---
# Enable LLM-based query rewriting and classification.
QUERY_CLASSIFICATION_ENABLED=true

# --- LLM Provider ---
# Optional: without this the assistant returns grounded source excerpts instead of an LLM summary.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# --- CORS & Auth ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
